{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amarax.dev/schemas/repository-assessment.schema.json",
  "title": "Platform Replication Repository Assessment",
  "type": "object",
  "required": ["repository", "upstream", "license", "runtime", "scores", "target", "disposition", "evidence"],
  "properties": {
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "upstream": {
      "type": "object",
      "required": ["default_branch", "pinned_ref", "archived"],
      "properties": {
        "default_branch": {"type": "string"},
        "pinned_ref": {"type": "string", "minLength": 7},
        "archived": {"type": "boolean"},
        "moved_from": {"type": ["string", "null"]}
      }
    },
    "license": {
      "type": "object",
      "required": ["status", "identifier", "notice_required", "dependency_review"],
      "properties": {
        "status": {"enum": ["verified", "unverified", "conflict", "missing"]},
        "identifier": {"type": "string"},
        "notice_required": {"type": "boolean"},
        "dependency_review": {"enum": ["pending", "passed", "failed", "conditional"]}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["build_reproduced", "self_hostable", "private_dependencies"],
      "properties": {
        "build_reproduced": {"type": "boolean"},
        "self_hostable": {"enum": ["yes", "partial", "no", "unknown"]},
        "private_dependencies": {"type": "array", "items": {"type": "string"}},
        "required_services": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scores": {
      "type": "object",
      "required": ["product_fit", "license_confidence", "self_hostability", "independence", "maintenance", "security", "integration_cost", "replacement_difficulty"],
      "additionalProperties": false,
      "properties": {
        "product_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "license_confidence": {"type": "integer", "minimum": 0, "maximum": 5},
        "self_hostability": {"type": "integer", "minimum": 0, "maximum": 5},
        "independence": {"type": "integer", "minimum": 0, "maximum": 5},
        "maintenance": {"type": "integer", "minimum": 0, "maximum": 5},
        "security": {"type": "integer", "minimum": 0, "maximum": 5},
        "integration_cost": {"type": "integer", "minimum": 0, "maximum": 5},
        "replacement_difficulty": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "target": {"type": "string"},
    "disposition": {"enum": ["ADOPT", "FORK", "REFERENCE", "REJECT", "UNDECIDED"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reviewed_at": {"type": "string", "format": "date"},
    "reviewer": {"type": "string"}
  }
}
